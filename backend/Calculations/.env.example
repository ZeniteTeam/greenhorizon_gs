# Copy this file to .env (same folder) and fill in the values. .env is git-ignored.

# Google Earth Engine project. Run `earthengine authenticate` once on this machine,
# or point EE_SERVICE_ACCOUNT_KEY to a service-account JSON key registered with Earth Engine.
EE_PROJECT=powerful-balm-394623
EE_SERVICE_ACCOUNT_KEY=

# Gemini key for the leaf-photo diagnosis (Google AI Studio -> Get API key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Our own cap on Gemini calls per day, kept below the free-tier quota.
GEMINI_DAILY_LIMIT=200

# true = scripted leaf diagnosis, Gemini is never called
GEMINI_MOCK=true
